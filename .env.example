# ==============================================================================
# Teaching Platform Environment Configuration Template
# Copy this file to .env and fill in your values. Never commit .env to Git.
# ==============================================================================

# Core Django Settings
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-random-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
SITE_URL=http://127.0.0.1:8000

# Google OAuth Credentials (Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database
# Dev default: sqlite:///db.sqlite3
# Prod example: postgresql://user:password@localhost:5432/teaching_db
DATABASE_URL=sqlite:///db.sqlite3

# Timezone & Localization
TIME_ZONE=Asia/Kathmandu

# Storage
# Dev default: django.core.files.storage.FileSystemStorage
# Prod example: storages.backends.s3boto3.S3Boto3Storage
MEDIA_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
PRIVATE_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage

# Cache
# Dev default: locmem (in-memory)
# Prod example: redis://127.0.0.1:6379/1 or database cache
CACHE_URL=locmemcache://

# Email Configuration
# Dev uses console email backend automatically in dev.py
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Teaching Platform <noreply@example.com>
NOTIFY_BY_EMAIL=False

# Error Monitoring (Production)
SENTRY_DSN=

# Video Streaming (Bunny Stream - Phase 5)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_SIGNING_ENABLED=False

# Assignment Submissions Configuration (Phase 6)
ASSIGNMENT_MAX_FILE_SIZE_BYTES=10485760
ASSIGNMENT_MAX_TEXT_LENGTH=20000

# Course Material Configuration (Phase 7C)
MATERIAL_MAX_FILE_SIZE_BYTES=26214400

# Security & Headers Configuration (Phase 8A)
# Session idle timeout in seconds (0 = disabled by default, e.g. 1800 for 30 minutes)
SESSION_IDLE_TIMEOUT_SECONDS=0
# Comma-separated trusted origins for CSRF protection in production (e.g. https://teaching.example.com)
CSRF_TRUSTED_ORIGINS=
# HSTS max-age lifetime in seconds (starts at 86400 / 1 day for safe rollout)
SECURE_HSTS_SECONDS=86400
# Include subdomains in HSTS (only enable if all subdomains strictly use HTTPS)
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# Admin URL path (e.g. admin/ or secret-admin-portal/)
DJANGO_ADMIN_URL=admin/

# Trusted Reverse Proxy Configuration (Phase 8B)
# Number of trusted reverse proxies in front of the app (0 = ignore X-Forwarded-For; 1 = single Nginx/LB)
NUM_PROXIES=0
# Optional dedicated client IP header set by a trusted proxy (e.g. CF-Connecting-IP or X-Real-IP)
TRUSTED_CLIENT_IP_HEADER=
